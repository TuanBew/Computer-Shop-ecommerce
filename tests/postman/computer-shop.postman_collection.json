{
  "info": {
    "name": "Computer Shop API",
    "_postman_id": "computer-shop-v1",
    "description": "Full API test collection for Computer Shop e-commerce",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "authToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"fullName\": \"Test User\", \"email\": \"test@example.com\", \"password\": \"password123\", \"phone\": \"0909000000\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Has token in response\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.metadata).to.have.property('token');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register User - Duplicate Email (Negative)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"fullName\": \"Test User\", \"email\": \"test@example.com\", \"password\": \"password123\", \"phone\": \"0909000000\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Duplicate email returns 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"test@example.com\", \"password\": \"password123\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Login returns token\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.metadata.token).to.be.a('string');",
                  "    pm.collectionVariables.set('authToken', json.metadata.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with Google",
          "request": {
            "method": "POST",
            "header": [
